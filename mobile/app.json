{
  "expo": {
    "name": "ArthaX",
    "slug": "arthax-mobile",
    "scheme": "arthax",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.arthax.mobile",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "CFBundleDisplayName": "ArthaX"
      }
    },
    "android": {
      "package": "com.arthax.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#090d16",
        "foregroundImage": "./assets/icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "extra": {
      "supabaseUrl": "https://fvpfzbuoizzjwgekuhot.supabase.co",
      "supabaseAnonKey": "sb_publishable_eb8KMAHsO_TnQgkhswFBXg_7tcL1qq4"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#090d16"
        }
      ]
    ]
  }
}
