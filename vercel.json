{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["bom1"],
  "schedules": {
    "daily-automation": {
      "schedule": "30 9 * * *",
      "timezone": "Asia/Kolkata",
      "path": "/api/v1/automation/cron",
      "requestMethod": "GET"
    },
    "zerodha-post-market-sync": {
      "schedule": "45 15 * * 1-5",
      "timezone": "Asia/Kolkata",
      "path": "/api/v1/integrations/zerodha/cron",
      "requestMethod": "GET"
    }
  }
}
