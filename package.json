{
  "name": "finance-dashboard",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run --prefix apps/web dev",
    "dev:all": "npm run services:dev & npm run --prefix apps/web dev",
    "services:dev": "npm run --prefix apps/account-service dev & npm run --prefix apps/investment-service dev & npm run --prefix apps/budget-service dev & npm run --prefix apps/parser-service dev & npm run --prefix apps/ai-mcp-service dev",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "build": "npm run --prefix apps/web build",
    "start": "npm run --prefix apps/web start",
    "lint": "eslint",
    "validate-env": "npx tsx scripts/validate-env.ts",
    "predev": "npm run validate-env",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest",
    "test:unit:watch": "jest --watch",
    "test:unit:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage",
    "test:e2e": "npx playwright test",
    "test:e2e:ui": "npx playwright test --ui",
    "test:all": "npm run test && npm run test:e2e"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@supabase/supabase-js": "^2.112.3",
    "drizzle-orm": "^0.45.2",
    "ioredis": "^6.0.0",
    "pg": "^8.22.0",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.2",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.20.4",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "express": "^5.2.1",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "jsdom": "^30.0.1",
    "shadcn": "^4.16.2",
    "typescript": "^5"
  }
}
