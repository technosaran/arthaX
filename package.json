{
  "name": "finance-dashboard",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev --turbo",
    "dev:all": "npm run services:dev & next dev --turbo",
    "services:dev": "npm run --prefix apps/account-service dev & npm run --prefix apps/investment-service dev & npm run --prefix apps/budget-service dev & npm run --prefix apps/parser-service dev & npm run --prefix apps/ai-mcp-service dev",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "validate-env": "npx tsx scripts/validate-env.ts",
    "predev": "npm run validate-env",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest",
    "test:unit:watch": "jest --watch",
    "test:unit:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage",
    "test:e2e": "npx playwright test",
    "test:e2e:ui": "npx playwright test --ui",
    "test:all": "npm run test && npm run test:e2e"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@react-pdf/renderer": "^4.5.1",
    "@sentry/nextjs": "^10.63.0",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.112.2",
    "@tanstack/react-table": "^8.21.3",
    "@types/pdf-parse": "^1.1.5",
    "@types/zxcvbn": "^4.4.5",
    "@vercel/analytics": "^2.0.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^12.39.0",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.29.0",
    "next": "^16.2.3",
    "pdf-parse": "^2.4.5",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hot-toast": "^2.6.0",
    "react-qr-code": "^2.2.0",
    "recharts": "^3.8.1",
    "swr": "^2.4.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3",
    "zxcvbn": "^4.4.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "^16.2.3",
    "express": "^5.2.1",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "jsdom": "^30.0.1",
    "shadcn": "^4.16.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
