{
  "name": "arthax",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:py": "python python_service/main.py",
    "dev:all": "npx concurrently -k -p \"[{name}]\" -n \"NEXT,PY\" -c \"cyan.bold,magenta.bold\" \"next dev\" \"python python_service/main.py\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:py": "python -m pytest",
    "db:types": "supabase gen types typescript --linked > src/types/database.types.ts",
    "zerodha:sync": "npx tsx --env-file=.env.local scripts/zerodhaAutoSync.ts",
    "mcp": "npx tsx src/mcp/server.ts",
    "mcp:http": "npx tsx src/mcp/httpServer.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@sentry/nextjs": "^11.20.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "@tanstack/react-query": "^5.108.4",
    "@upstash/redis": "^1.41.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "lucide-react": "^1.83.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.5",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.5",
    "typescript": "^5",
    "vite": "^8.4.0",
    "vitest": "^5.1.2"
  },
  "overrides": {
    "dompurify": "^3.4.18"
  }
}
