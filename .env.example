# ==============================================================================
# ArthaX - Production Environment Configuration Template
# Duplicate this file to .env.local and populate with your secure credentials.
# NEVER commit .env.local or secret keys into source control!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core Application & Base URL
# ------------------------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. Supabase Cloud Configuration
# Required for Database, RLS, Auth, Realtime & Storage
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key
# Backend Admin / Service Role Access (Kept strictly server-side)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key
# Supabase JWT Secret for Python serverless microservice token validation
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-for-token-verification

# ------------------------------------------------------------------------------
# 3. Application Security & Cryptographic Master Key
# 32-byte hex-encoded key for AES-256-GCM authenticated encryption (64 hex characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ------------------------------------------------------------------------------
ENCRYPTION_MASTER_KEY=00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff
ADMIN_API_KEY=your-secure-admin-api-key
CRON_SECRET=your-cron-and-job-trigger-secret

# ------------------------------------------------------------------------------
# 4. Upstash Redis (Distributed Rate Limiting, Idempotency & Caching)
# ------------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=https://your-redis-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-rest-token

# ------------------------------------------------------------------------------
# 5. Sentry Observability & Error Tracking
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# ------------------------------------------------------------------------------
# 6. Google Gemini AI Engine
# ------------------------------------------------------------------------------
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere

# ------------------------------------------------------------------------------
# 7. Zerodha Kite Connect Integration
# ------------------------------------------------------------------------------
ZERODHA_API_KEY=your-kite-api-key
ZERODHA_API_SECRET=your-kite-api-secret
# Automated Kite TOTP & Multi-Factor Login
ZERODHA_USER_ID=AB1234
ZERODHA_PASSWORD=your-zerodha-password
ZERODHA_TOTP_SECRET=JBSWY3DPEHPK3PXP
# Owner restriction: user UUID allowed to run automated Zerodha sync
ZERODHA_AUTHORIZED_USER_ID=00000000-0000-0000-0000-000000000000

# ------------------------------------------------------------------------------
# 8. Apple Shortcuts Integration
# ------------------------------------------------------------------------------
SHORTCUTS_API_KEY=your-custom-shortcuts-bearer-secret
SHORTCUTS_AUTHORIZED_USER_ID=00000000-0000-0000-0000-000000000000

# ------------------------------------------------------------------------------
# 9. Telegram Bot Integration
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_BOT_USERNAME=arthax_finance_bot
TELEGRAM_WEBHOOK_SECRET=your-custom-telegram-webhook-secret
TELEGRAM_AUTHORIZED_USER_ID=00000000-0000-0000-0000-000000000000

# ------------------------------------------------------------------------------
# 10. WhatsApp Business Cloud API Integration
# ------------------------------------------------------------------------------
WHATSAPP_PHONE_NUMBER_ID=100000000000000
WHATSAPP_ACCESS_TOKEN=EAAG...
WHATSAPP_VERIFY_TOKEN=your-webhook-verification-token
WHATSAPP_APP_SECRET=your-meta-app-secret
WHATSAPP_AUTHORIZED_USER_ID=00000000-0000-0000-0000-000000000000

# ------------------------------------------------------------------------------
# 11. Third-Party Brand & Asset Logos (Optional)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_LOGOS_DEV_API_KEY=pk_your_logos_dev_key

# ------------------------------------------------------------------------------
# 12. Python Analytics Engine (FastAPI)
# ------------------------------------------------------------------------------
INTERNAL_SERVICE_KEY=your-internal-service-secret
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://arthax.vercel.app

# ------------------------------------------------------------------------------
# 13. Google OAuth & Gmail Statement Ingestion
# ------------------------------------------------------------------------------
# Google Cloud Console OAuth 2.0 Client ID and Secret (Web Application)
# Authorized redirect URI: https://<domain>/api/v1/integrations/gmail/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret
# Dedicated HMAC-SHA256 signing secret for OAuth CSRF state verification (required in production)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OAUTH_STATE_SECRET=00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff
